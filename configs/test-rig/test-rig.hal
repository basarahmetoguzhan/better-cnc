# =============================================================================
# test-rig.hal - Phase 1.5 test machine: 3-axis DIY wooden-frame router
# =============================================================================
#
#   *** 2026-11-12: Y DIR FIXED, SWITCH NETS CONNECTED, HOMING WORKS ***
#
# The board is now fully interrogated (2026-08-05). Every hm2_ pin name below is
# built from [HOSTMOT2]BOARD = 7i92 in the INI, giving the prefix hm2_7i92.0,
# and the stepgen-to-connector mapping is VERIFIED from the pin descriptors -
# both were assumptions until the dumps arrived.
#
#   docs/board-dumps/readhmid-10.10.10.10-2026-08-05.txt
#   docs/board-dumps/printpd-10.10.10.10-2026-08-05.txt
#   docs/10-7i92-pinout-verified.md   <- the readable pin map
#
# The SWITCH WIRING is mapped by hand (ends + polarity, docs/DURUM.md:69-82),
# Y+ = rear since Faz 2; the nets are CONNECTED and were tested in Faz 5.
#
#   grep -n 'ASSUMPTION[:]' configs/test-rig/test-rig.hal    # prints nothing
#
# Motors COUPLED; soft limits act only once homed; no hw estop: hand on power.
#
# Structure follows the upstream sample
#   reference/linuxcnc/configs/by_interface/mesa/hm2-stepper/hm2-stepper-eth.hal
# which is the config type this most closely resembles (hm2_eth, stepgens,
# open loop). Pin and parameter names are cited to source where non-obvious.
# =============================================================================


# =============================================================================
# LOADS
# =============================================================================

# Kinematics - trivkins, from [KINS]KINEMATICS
loadrt [KINS]KINEMATICS

# Motion controller. No base thread is loaded: step pulses are generated in the
# FPGA, not in software, so there is nothing for a fast thread to do.
loadrt [EMCMOT]EMCMOT servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS

# -----------------------------------------------------------------------------
# hostmot2 driver, with module debug output ENABLED.
#
# debug_modules=1 makes the driver print its per-module summary, including:
#
#     hm2/hm2_7i92.0:     clock_frequency: 100000000 Hz (100.00 MHz)
#
# That print is gated behind `if (debug_modules)` at hostmot2.c:1672-1675, and
# the parameter defaults to 0 (hostmot2.c:53-54), so without this flag the line
# never appears. The clock matters because steplen, stepspace, dirsetup and
# dirhold are ALL scaled by it (stepgen.c:348, :359, :370, :381) and the driver
# takes the value on faith from the IDROM - it cannot verify it.
#
# CLOCK RESOLVED (2026-08-05) - and our earlier assumption was WRONG.
#   We previously expected 33 MHz, reasoning from the stock 7i96. The board is
#   a 7i92 and its IDROM reports:
#       Clock Low frequency:  100.0000 MHz
#       Clock High frequency: 200.0000 MHz
#   (readhmid-10.10.10.10-2026-08-05.txt:17-18)
#   The StepGen module's own ClockFrequency line confirms it uses the 100 MHz
#   clock (readhmid:68); the PWM module is the only one on 200 MHz (readhmid:77).
#
#   Note the 50.000 MHz crystal we observed on the board in docs/04 is NOT the
#   logic clock - the FPGA synthesises 100/200 MHz from it via a PLL, which is
#   entirely normal. The crystal was never evidence of the logic clock rate, and
#   treating it as suspicious was over-reading it.
#
#   These flags are kept ON deliberately. They cost nothing at load time and the
#   dmesg output is the record of what the firmware declared - worth having every
#   time the config is loaded, not just once.
#
# debug_idrom=1 additionally dumps the IDROM header (gated at
# hostmot2.c:742-744), which gives ClockLow/ClockHigh independently.
#
# Capture both after starting:   dmesg | grep -i 'clock\|idrom'
# and save the output into docs/board-dumps/.
# -----------------------------------------------------------------------------
loadrt hostmot2 debug_modules=1 debug_idrom=1

# Low-level Ethernet driver. board_ip and config come from [HOSTMOT2].
loadrt [HOSTMOT2](DRIVER) board_ip=[HOSTMOT2](BOARD_IP) config=[HOSTMOT2](CONFIG)

# Estop latch - see the ESTOP section at the bottom.
loadrt estop_latch


# =============================================================================
# THREADS
# =============================================================================
# Read first, compute, write last. estop-latch runs after the write so a fault
# raised this cycle is latched before the next one.
#
# RESOLVED (was assumption A2): hm2_[HOSTMOT2](BOARD).0 resolves to hm2_7i92.0.
#   The board reports itself as "7I92" over LBP16 and its IDROM says
#   BoardName MESA7I92 (readhmid-10.10.10.10-2026-08-05.txt:4-6, :12), so
#   hm2_eth takes the 7I92 branch at hm2_eth.c:1183 and builds the name
#   "hm2_7i92.0" via hm2_eth.c:1487.
#
#   We previously assumed a 7i96 and prefix hm2_7i96.0. That was WRONG.
#   Corrected here and in [HOSTMOT2]BOARD, which is the single place the prefix
#   is defined - every line below indirects through it.

addf hm2_[HOSTMOT2](BOARD).0.read      servo-thread
addf motion-command-handler            servo-thread
addf motion-controller                 servo-thread
addf hm2_[HOSTMOT2](BOARD).0.write     servo-thread
addf estop-latch.0                     servo-thread


# =============================================================================
# STEPGEN CONFIGURATION
# =============================================================================
#
# RESOLVED (was assumption A4): StepGen instance N drives the AXIS N connector,
#   so stepgen.00/.01/.02 are AXIS 0/1/2 and therefore X/Y/Z; .03 (AXIS 3) is Y's 2nd motor.
#
#   The pin descriptors give the mapping exactly. From
#   readhmid-10.10.10.10-2026-08-05.txt:108-119 and
#   printpd-10.10.10.10-2026-08-05.txt:29-88, on connector P2:
#
#     StepGen 0   IO  4 Step   IO  5 Dir      <- AXIS 0, used as X
#     StepGen 1   IO  6 Step   IO  7 Dir      <- AXIS 1, used as Y
#     StepGen 2   IO  8 Step   IO  9 Dir      <- AXIS 2, used as Z
#     StepGen 3   IO 10 Step   IO 11 Dir      <- AXIS 3, Y's 2nd motor (end of file)
#     StepGen 4   IO 12 Step   IO 13 Dir      <- disabled
#     StepGen 5   IO 14 Step   IO 15 Dir      <- disabled
#
#   Note the order is Step then Dir, ascending - NOT the Dir-before-Step order
#   docs/03 found in the stock Mesa 7i96 data. Another reason that document does
#   not apply to this board.
#
#   Confirmed physically since (docs/DURUM.md:115): jogging drives AXIS 0 = X,
#   AXIS 1 = Y, AXIS 2 = Z, and on 2026-11-12 AXIS 3 = StepGen 3 as well (both
#   Y sides moved ~50 mm: left 50.3, right 49.7). The Y DIR fault is RESOLVED:
#   two optos on one output, see the end of this file. The dump alone could
#   only prove which FPGA pins carry which signal.
#
# step_type = 0 selects Step/Dir output (hostmot2.adoc:528-532).
#   0 = Step/Dir, 1 = Up/Down, 2 = Quadrature. TB6560 wants Step/Dir.
#
# Timing parameters are all in NANOSECONDS (hostmot2.adoc:511-537) and come
# from [JOINT_n] custom variables. Values are from the TB6560 analysis in
# docs/09 - dirsetup/dirhold/stepspace have no GRBL equivalent so they could
# not come from the machine's EEPROM.
#
# position-scale takes [JOINT_n]SCALE directly. There is NO dirinvert parameter
# on a hostmot2 stepgen - to reverse an axis, negate SCALE in the INI.
# =============================================================================

# ------------------------------- X / joint 0 ---------------------------------
setp hm2_[HOSTMOT2](BOARD).0.stepgen.00.step_type        0
setp hm2_[HOSTMOT2](BOARD).0.stepgen.00.position-scale   [JOINT_0]SCALE
setp hm2_[HOSTMOT2](BOARD).0.stepgen.00.steplen          [JOINT_0]STEPLEN
setp hm2_[HOSTMOT2](BOARD).0.stepgen.00.stepspace        [JOINT_0]STEPSPACE
setp hm2_[HOSTMOT2](BOARD).0.stepgen.00.dirsetup         [JOINT_0]DIRSETUP
setp hm2_[HOSTMOT2](BOARD).0.stepgen.00.dirhold          [JOINT_0]DIRHOLD
setp hm2_[HOSTMOT2](BOARD).0.stepgen.00.maxvel           [JOINT_0]STEPGEN_MAX_VEL
setp hm2_[HOSTMOT2](BOARD).0.stepgen.00.maxaccel         [JOINT_0]STEPGEN_MAX_ACC

# ------------------------------- Y / joint 1 ---------------------------------
setp hm2_[HOSTMOT2](BOARD).0.stepgen.01.step_type        0
setp hm2_[HOSTMOT2](BOARD).0.stepgen.01.position-scale   [JOINT_1]SCALE
setp hm2_[HOSTMOT2](BOARD).0.stepgen.01.steplen          [JOINT_1]STEPLEN
setp hm2_[HOSTMOT2](BOARD).0.stepgen.01.stepspace        [JOINT_1]STEPSPACE
setp hm2_[HOSTMOT2](BOARD).0.stepgen.01.dirsetup         [JOINT_1]DIRSETUP
setp hm2_[HOSTMOT2](BOARD).0.stepgen.01.dirhold          [JOINT_1]DIRHOLD
setp hm2_[HOSTMOT2](BOARD).0.stepgen.01.maxvel           [JOINT_1]STEPGEN_MAX_VEL
setp hm2_[HOSTMOT2](BOARD).0.stepgen.01.maxaccel         [JOINT_1]STEPGEN_MAX_ACC

# ------------------------------- Z / joint 2 ---------------------------------
setp hm2_[HOSTMOT2](BOARD).0.stepgen.02.step_type        0
setp hm2_[HOSTMOT2](BOARD).0.stepgen.02.position-scale   [JOINT_2]SCALE
setp hm2_[HOSTMOT2](BOARD).0.stepgen.02.steplen          [JOINT_2]STEPLEN
setp hm2_[HOSTMOT2](BOARD).0.stepgen.02.stepspace        [JOINT_2]STEPSPACE
setp hm2_[HOSTMOT2](BOARD).0.stepgen.02.dirsetup         [JOINT_2]DIRSETUP
setp hm2_[HOSTMOT2](BOARD).0.stepgen.02.dirhold          [JOINT_2]DIRHOLD
setp hm2_[HOSTMOT2](BOARD).0.stepgen.02.maxvel           [JOINT_2]STEPGEN_MAX_VEL
setp hm2_[HOSTMOT2](BOARD).0.stepgen.02.maxaccel         [JOINT_2]STEPGEN_MAX_ACC


# =============================================================================
# MOTION <-> STEPGEN WIRING
# =============================================================================
#
# control-type FALSE = position mode: motion sends a position command and the
# stepgen closes its own internal loop on the FPGA accumulator. This is the
# normal arrangement for step/dir and is what the upstream sample uses.
#
# control-type is a bit IN pin (stepgen.c:931), not a parameter, and defaults
# to FALSE - so position mode is already the default and the upstream sample
# does not set it. It is set explicitly below anyway: this is a draft config
# that will be read by someone trying to understand it, and an implicit default
# is a thing you have to know rather than a thing you can see.
#
# position-fb comes from that same accumulator (stepgen.c:117-120). It counts
# steps the FPGA emitted - it is NOT an independent measurement of where the
# axis physically is. See the FERROR discussion in the INI.
# =============================================================================

# ------------------------------- X / joint 0 ---------------------------------
setp   hm2_[HOSTMOT2](BOARD).0.stepgen.00.control-type   0
newsig emcmot.00.enable bit
sets   emcmot.00.enable FALSE
net emcmot.00.enable <= joint.0.amp-enable-out
net emcmot.00.enable => hm2_[HOSTMOT2](BOARD).0.stepgen.00.enable

net motor.00.pos-cmd joint.0.motor-pos-cmd => hm2_[HOSTMOT2](BOARD).0.stepgen.00.position-cmd
net motor.00.pos-fb  hm2_[HOSTMOT2](BOARD).0.stepgen.00.position-fb => joint.0.motor-pos-fb

# ------------------------------- Y / joint 1 ---------------------------------
setp   hm2_[HOSTMOT2](BOARD).0.stepgen.01.control-type   0
newsig emcmot.01.enable bit
sets   emcmot.01.enable FALSE
net emcmot.01.enable <= joint.1.amp-enable-out
net emcmot.01.enable => hm2_[HOSTMOT2](BOARD).0.stepgen.01.enable

net motor.01.pos-cmd joint.1.motor-pos-cmd => hm2_[HOSTMOT2](BOARD).0.stepgen.01.position-cmd
net motor.01.pos-fb  hm2_[HOSTMOT2](BOARD).0.stepgen.01.position-fb => joint.1.motor-pos-fb

# ------------------------------- Z / joint 2 ---------------------------------
setp   hm2_[HOSTMOT2](BOARD).0.stepgen.02.control-type   0
newsig emcmot.02.enable bit
sets   emcmot.02.enable FALSE
net emcmot.02.enable <= joint.2.amp-enable-out
net emcmot.02.enable => hm2_[HOSTMOT2](BOARD).0.stepgen.02.enable

net motor.02.pos-cmd joint.2.motor-pos-cmd => hm2_[HOSTMOT2](BOARD).0.stepgen.02.position-cmd
net motor.02.pos-fb  hm2_[HOSTMOT2](BOARD).0.stepgen.02.position-fb => joint.2.motor-pos-fb


# =============================================================================
# LIMIT AND HOME SWITCHES - CONNECTED 2026-11-12 (Faz 5)
# =============================================================================
#
# The nets at the end of this section are LIVE. Both questions below are
# answered (docs/DURUM.md:69-82; Y+ = rear, Faz 2), and Faz 5 pressed every
# switch by hand with the machine ON: each tripped its own joint's limit.
# Wrong polarity = always on limit or, far worse, never: re-check on rewiring.
#
# QUESTION 1 - POLARITY. ANSWERED by hand for THIS rig (docs/DURUM.md:71):
#   idle .in = TRUE, pressed = FALSE -> use .in_not. GRBL $5 = 0 suggests normally-open.
#   The inputs are opto-isolated (docs/04, 24 V design inferred from the
#   4.7k/510R resistor pair). An optocoupler input stage commonly inverts, so
#   .in may read TRUE when the switch is OPEN. Every pin has both .in and
#   .in_not (ioport.c:250, :263) - LinuxCNC inverts an input by choosing the
#   negated pin, not by setting a parameter. Pick whichever reads FALSE when
#   the axis is clear of the switch.
#
#   How to re-check (e.g. after rewiring): machine powered but NOT enabled, run
#       halcmd -kf
#       halcmd: loadrt ...   (or just run this config and open halmeter)
#   watch each gpio pin while pushing each switch by hand. Record which pin
#   moves, and in which direction.
#
# QUESTION 2 - SENSOR-TO-END MAPPING. Which physical end of which axis is each
#   sensor at?
#
#   NOW VERIFIED - the IO numbers and their permanence:
#   IO 17 through 24 have NO Secondary Tag whatsoever in the pin descriptors
#   (printpd-10.10.10.10-2026-08-05.txt:94-109). They are not "GPIO until some
#   module claims them" - there is no module that CAN claim them. They are
#   permanently, unconditionally GPIO, whatever the config string says. That is
#   the strongest form this fact could take, and it retires any worry about the
#   inputs being stolen by a module.
#
#   The vendor silkscreen maps straight onto global IO numbers, as docs/08
#   hypothesised and the dumps confirm:
#       IO 17 = CW        IO 18 = OUT 1     IO 19 = OUT 2
#       IO 20 21 22 23 24 = the five isolated inputs
#
#   NOW ALSO VERIFIED BY HAND (docs/DURUM.md:69-82): 020 = X right, 021 = X left,
#   022 = Y rear, 023 = Y front, 024 = Z top; no Z bottom switch. X+ = right and
#   Z+ = up, so gpio.020 is X's MAXIMUM end; Y+ = rear, so gpio.022 is Y's.
#
# THE MAPPING, as netted below (all .in_not) and tested in Faz 5. A pressed
#   switch with the machine ON gives 'joint N on limit switch error':
#
#     gpio.021  X LEFT   ->  joint.0 home + negative limit    N = 0
#     gpio.020  X RIGHT  ->  joint.0 positive limit           N = 0
#     gpio.023  Y FRONT  ->  joint.1 home + negative limit    N = 1
#     gpio.022  Y REAR   ->  joint.1 positive limit           N = 1
#     gpio.024  Z TOP    ->  joint.2 home + positive limit    N = 2, no Z bottom
#
#   On a limit the machine will not enable: Override Limits, jog off AT ONCE -
#   LinuxCNC 2.9 clears the override as soon as motion is next in position.
# Note that home and limit SHARE a switch on X, Y and Z. That is why
# HOME_IGNORE_LIMITS = YES is set on all three joints in the INI - see the
# citation of ini-homing.adoc:168-176 there. The same switch signal gets netted
# to both the home input and a limit input.
#
# Motion's switch input pins, verified from source:
#     joint.N.home-sw-in      homing.c:245
#     joint.N.pos-lim-sw-in   motion.c:760
#     joint.N.neg-lim-sw-in   motion.c:761
#
# Sharing one physical switch between several pins is a documented, supported
# pattern - see the worked example at
# reference/linuxcnc/docs/src/config/stepper.adoc:123-131.
#
# -----------------------------------------------------------------------------
# X - joint 0. gpio.021 = X LEFT = home + negative limit; gpio.020 = X RIGHT = positive.
# Inputs idle HIGH and go LOW when pressed (DURUM.md:71, Faz 5), hence .in_not.
# -----------------------------------------------------------------------------
net x-home-limit  hm2_[HOSTMOT2](BOARD).0.gpio.021.in_not
net x-home-limit  => joint.0.home-sw-in
net x-home-limit  => joint.0.neg-lim-sw-in
net x-max-limit   hm2_[HOSTMOT2](BOARD).0.gpio.020.in_not
net x-max-limit   => joint.0.pos-lim-sw-in

# -----------------------------------------------------------------------------
# Y - joint 1. Y+ = rear (Faz 2): gpio.023 FRONT = home + negative, gpio.022 REAR = positive.
# -----------------------------------------------------------------------------
net y-home-limit  hm2_[HOSTMOT2](BOARD).0.gpio.023.in_not
net y-home-limit  => joint.1.home-sw-in
net y-home-limit  => joint.1.neg-lim-sw-in
net y-max-limit   hm2_[HOSTMOT2](BOARD).0.gpio.022.in_not
net y-max-limit   => joint.1.pos-lim-sw-in

# -----------------------------------------------------------------------------
# Z - joint 2. ONE sensor only, at the TOP. Z homes UP toward it, so the top is
# the positive limit and the home switch, and there is NO bottom limit switch.
# Only the soft limit [JOINT_2]MIN_LIMIT = -96.5 (Faz 4: 3.3 mm above the table)
# guards the bottom of Z - and only AFTER HOMING. Unhomed, nothing stops Z down.
# -----------------------------------------------------------------------------
net z-home-limit  hm2_[HOSTMOT2](BOARD).0.gpio.024.in_not
net z-home-limit  => joint.2.home-sw-in
net z-home-limit  => joint.2.pos-lim-sw-in


# =============================================================================
# ESTOP CHAIN - GUI ONLY. THERE IS NO HARDWARE ESTOP INPUT.
# =============================================================================
#
#   *** SAFETY: this machine has NO physical emergency stop wired to the
#       controller. The only software estop is the GUI button. ***
#
# Why: the board brings out exactly five isolated digital inputs (docs/04,
# docs/08), and all five are consumed by the limit/home switches - two for X,
# two for Y, one for Z. No isolated input is left for an estop button.
# A sixth input is possible, though (2026-10-18 note): since OPEN-QUESTIONS B2
# closed (2026-08-05), num_encoders=0 - already in [HOSTMOT2]CONFIG - frees
# IO 25-33 as GPIO at the encoder terminals. The circuit behind those terminals
# is UNVERIFIED - check it with an ohmmeter before connecting any 24 V device.
#
# What this means in practice:
#   - The GUI estop stops MOTION. It does not remove power from anything.
#   - If the machine misbehaves, the reliable stop is to cut power at the
#     supply or a mains switch. Keep that within reach whenever it is powered.
#   - This is acceptable for a small wooden-frame test router with a hand on
#     the plug. It is NOT acceptable for the marble machine, which will need a
#     hardware estop chain that drops drive power independently of the
#     controller.
#
# Options if a hardware estop is wanted on this machine later: use an encoder-
# terminal GPIO (IO 25-33, after the ohmmeter check above), free an isolated
# input by giving up a limit switch (X and Y each have two; one per axis would
# do for homing), or wire the estop into the drive-power chain so it works even
# if the controller dies - which is the better engineering answer anyway.
#
# The chain below is the upstream sample's arrangement
# (hm2-stepper-eth.hal:194-197):
#
#   iocontrol.0.user-request-enable  the GUI estop-reset request
#                                    (ioControl.cc:319-321)
#   estop-latch.0.fault-in           a fault source latches estop
#   estop-latch.0.ok-out  ->  iocontrol.0.emc-enable-in
#
# The one genuine fault source available is the hostmot2 WATCHDOG. It bites if
# the driver stops writing to the board - i.e. if the Ethernet link drops, the
# host PC locks up, or the realtime thread dies. It is not a substitute for an
# estop button, but it does mean a comms failure stops the machine rather than
# leaving the stepgens running on their last command.
# =============================================================================

net user-enable   iocontrol.0.user-request-enable => estop-latch.0.reset
net enable-latch  estop-latch.0.ok-out            => iocontrol.0.emc-enable-in
net watchdog      hm2_[HOSTMOT2](BOARD).0.watchdog.has_bit => estop-latch.0.fault-in


# =============================================================================
# TOOL CHANGE LOOPBACK
# =============================================================================
# No tool changer. Loop the requests straight back so a T/M6 in G-code does not
# hang waiting for a changer that does not exist.
# =============================================================================
net tool-prep-loop   iocontrol.0.tool-prepare => iocontrol.0.tool-prepared
net tool-change-loop iocontrol.0.tool-change  => iocontrol.0.tool-changed


# =============================================================================
# Y's SECOND MOTOR - AXIS 3 / stepgen.03 (2026-11-12)
# =============================================================================
# The rig's Y has two motors, each on its own TB6560 (the two middle drivers).
# Until 2026-11-12 both hung on AXIS 1, and neither driver ever changed
# direction - the "Y DIR fault". Measured with the two opto inputs in parallel
# on AXIS 1, against X's single driver on AXIS 0 (faz1_y_dir in
# docs/board-dumps/rig-measurements-2026-11-12.json):
#
#     DIR high     AXIS 1 (two drivers) 2.43 V    AXIS 0 (X, one) 3.11 V
#     DIR low                                     AXIS 0 (X, one) 0.2 V
#     STEP idle    AXIS 1 (two drivers) 2.55 V    AXIS 0 (X, one) 3.21 V
#
# CAUSE, confirmed: the board's outputs are 3.3 V logic and the rig is wired
# COMMON-CATHODE (driver CLK-/CW- to GND, the board's 5V terminal unused - not
# the common-anode wiring of docs/09:54-62). One 3.3 V output cannot drive two
# optocouplers. FIX: one output per driver - the second driver on AXIS 3 =
# stepgen.03 (IO 10 Step / IO 11 Dir, docs/10), fed exactly what stepgen.01
# gets: same INI values, same command, same enable.
#
# RESULTS: Y moves both ways and both stepgen counters stay equal (Gate 1).
# In the Faz 3 SCALE check a 50.005 mm Y move measured 50.3 mm on the left
# gantry side and 49.7 mm on the right, so AXIS 3 = StepGen 3 is physically
# confirmed. One joint, two step generators: no separate homing or squaring
# (the marble machine's gantry, docs/MERMER-GECIS.md, is a different job), and
# the two sides' racking has not been checked yet - an open work item.
# Feedback stays on stepgen.01. Needs num_stepgens=4 in [HOSTMOT2]CONFIG.
# =============================================================================
setp   hm2_[HOSTMOT2](BOARD).0.stepgen.03.step_type        0
setp   hm2_[HOSTMOT2](BOARD).0.stepgen.03.position-scale   [JOINT_1]SCALE
setp   hm2_[HOSTMOT2](BOARD).0.stepgen.03.steplen          [JOINT_1]STEPLEN
setp   hm2_[HOSTMOT2](BOARD).0.stepgen.03.stepspace        [JOINT_1]STEPSPACE
setp   hm2_[HOSTMOT2](BOARD).0.stepgen.03.dirsetup         [JOINT_1]DIRSETUP
setp   hm2_[HOSTMOT2](BOARD).0.stepgen.03.dirhold          [JOINT_1]DIRHOLD
setp   hm2_[HOSTMOT2](BOARD).0.stepgen.03.maxvel           [JOINT_1]STEPGEN_MAX_VEL
setp   hm2_[HOSTMOT2](BOARD).0.stepgen.03.maxaccel         [JOINT_1]STEPGEN_MAX_ACC
setp   hm2_[HOSTMOT2](BOARD).0.stepgen.03.control-type     0
net emcmot.01.enable => hm2_[HOSTMOT2](BOARD).0.stepgen.03.enable
net motor.01.pos-cmd => hm2_[HOSTMOT2](BOARD).0.stepgen.03.position-cmd
